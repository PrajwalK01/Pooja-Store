# Copy this to .env and fill in your values

FLASK_SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
ADMIN_SETUP_KEY=replace-with-a-one-time-setup-key

# Local dev: path to your service-account JSON file
# FIREBASE_CREDENTIALS=serviceAccountKey.json

# Cloud/Render: paste the entire JSON file contents here
FIREBASE_CREDENTIALS_JSON=

FIREBASE_STORAGE_BUCKET=your-project.appspot.com
SALON_NAME=Gayathri Pooja Store
CURRENCY_SYMBOL=Rs
WHATSAPP_NUMBER=919999999999
MAPS_QUERY=Gayathri Pooja Store, Your Location

# Cloudinary (for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
